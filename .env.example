# Application Environment (development / production)
APP_ENV=development

# ============================================================================
# Database Configuration
# ============================================================================

# 1. Unified Gateway / Agent Database (Moeez's orchestration & Agent PostgreSQL)
# NOTE: In unified integration mode (when SHARED_DATABASE_URL is set), Vision
# strictly ignores DATABASE_URL for catalog lookups unless CATALOG_DATABASE_URL is set.
DATABASE_URL=postgresql://username:password@host:5432/agent_db?sslmode=require

# 2. Shared Cross-Module Pipeline Database (Moeez's Supabase PostgreSQL)
# Used for pipeline_runs, assets, extracted_data, module_events cross-module handoffs
SHARED_DATABASE_URL=postgresql://postgres.project_ref:your_password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# 3. Vision Module Product Catalog Database:
# - Default: Local SQLite catalog (data/catalog.db)
# - Optional: Set CATALOG_DATABASE_URL if hosting catalog_items on dedicated PostgreSQL
# - Standalone legacy: If SHARED_DATABASE_URL is unset, legacy DATABASE_URL is used as catalog DB
DATABASE_PATH=data/catalog.db
# CATALOG_DATABASE_URL=postgresql://username:password@host:5432/catalog_db?sslmode=require

# Storage & Path Configurations
CATALOG_IMAGES_DIR=data/images
EMBEDDINGS_DIR=artifacts/embeddings
FAISS_INDEX_DIR=artifacts/faiss
# FAISS_CLIP_INDEX_PATH=artifacts/faiss/clip.index
# FAISS_RESNET_INDEX_PATH=artifacts/faiss/resnet.index
# RAW_IMAGES_DIR=data/images

# CORS Allowed Origins (Comma-separated list of allowed frontend domains for production)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication Secret Key (HMAC-SHA256 signing key for bearer tokens — required in production)
AUTH_SECRET_KEY=change-me-in-production
