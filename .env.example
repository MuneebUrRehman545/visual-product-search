# Application Environment (development / production)
APP_ENV=development

# Database Configuration:
# For Local SQLite: DATABASE_PATH=data/catalog.db (or DATABASE_URL=sqlite:///data/catalog.db)
# For Hosted PostgreSQL (Supabase / Neon):
DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require
DATABASE_PATH=data/catalog.db

# Storage & Path Configurations
CATALOG_IMAGES_DIR=data/images
EMBEDDINGS_DIR=artifacts/embeddings
FAISS_INDEX_DIR=artifacts/faiss

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication Secret Key (HMAC-SHA256 signing key for bearer tokens — change before deploying)
AUTH_SECRET_KEY=change-me-in-production
